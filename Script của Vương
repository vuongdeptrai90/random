-- ESP NPC
----------------------------------------------------------------
local ESP = { Enabled = false, Tracked = {}, Conns = {} }

local ESP_CONFIG = {
	Color = Color3.fromRGB(0, 255, 100),
	LowHealthColor = Color3.fromRGB(255, 60, 60),
	FillTransparency = 0.5,
	MaxDistance = 500,
	UpdateRate = 0.1,
}

local espFolder = make("Folder", { Name = "ESPFolder" }, gui)

local function isNPC(model)
	return model:IsA("Model")
		and model:FindFirstChildOfClass("Humanoid") ~= nil
		and Players:GetPlayerFromCharacter(model) == nil
end

local function removeNPC(model)
	local data = ESP.Tracked[model]
	if not data then return end
	data.Highlight:Destroy()
	data.Gui:Destroy()
	ESP.Tracked[model] = nil
end

local function addNPC(model)
	if ESP.Tracked[model] or not isNPC(model) then return end
	local adornee = model:FindFirstChild("Head")
		or model:FindFirstChild("HumanoidRootPart")
		or model.PrimaryPart
	if not adornee then return end

	local h = make("Highlight", {
		Adornee = model,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		FillColor = ESP_CONFIG.Color,
		OutlineColor = Color3.new(1, 1, 1),
		FillTransparency = ESP_CONFIG.FillTransparency,
	}, espFolder)

	local bb = make("BillboardGui", {
		Adornee = adornee,
		AlwaysOnTop = true,
		Size = UDim2.fromOffset(140, 30),
		StudsOffset = Vector3.new(0, 2.5, 0),
	}, espFolder)

	local lbl = make("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.3,
	}, bb)

	ESP.Tracked[model] = { Highlight = h, Gui = bb, Label = lbl }
end

local function clearAll()
	for model in pairs(ESP.Tracked) do removeNPC(model) end
	for _, c in ipairs(ESP.Conns) do c:Disconnect() end
	table.clear(ESP.Conns)
end

local function enableESP()
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") and v.Parent then addNPC(v.Parent) end
	end

	table.insert(ESP.Conns, workspace.DescendantAdded:Connect(function(v)
		if v:IsA("Humanoid") then
			task.defer(function()
				if v.Parent then addNPC(v.Parent) end
			end)
		end
	end))

	table.insert(ESP.Conns, workspace.DescendantRemoving:Connect(function(v)
		if ESP.Tracked[v] then removeNPC(v) end
	end))

	local acc = 0
	table.insert(ESP.Conns, RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < ESP_CONFIG.UpdateRate then return end
		acc = 0

		local myRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		local origin = myRoot and myRoot.Position or Camera.CFrame.Position

		for model, data in pairs(ESP.Tracked) do
			local hum = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart

			if not model:IsDescendantOf(workspace) or not hum then
				removeNPC(model)
			else
				local dist = root and (root.Position - origin).Magnitude or math.huge
				local visible = hum.Health > 0 and dist <= ESP_CONFIG.MaxDistance

				data.Highlight.Enabled = visible
				data.Gui.Enabled = visible

				if visible then
					local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
					data.Highlight.FillColor = ESP_CONFIG.LowHealthColor:Lerp(ESP_CONFIG.Color, ratio)
					data.Label.Text = string.format("%s | %d HP | %dm",
						model.Name, math.floor(hum.Health), math.floor(dist))
				end
			end
		end
	end))
end

function ESP.Toggle(state)
	ESP.Enabled = state
	if state then enableESP() else clearAll() end
end

