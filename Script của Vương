local function card(order, icon, name, isToggle, onClick)
	local b = make("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = THEME.Card,
		LayoutOrder = order,
	}, grid)
	corner(b, 8)

	local st = make("UIStroke", {
		Color = THEME.Off,
		Thickness = 1.2,
		Transparency = 0.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, b)

	make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.fromOffset(24, 24),
		Text = icon,
		TextSize = 18,
	}, b)

	-- chấm trạng thái: xanh = đang bật
	local dot = make("Frame", {
		Position = UDim2.new(1, -16, 0, 8),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = THEME.PillOff,
		Visible = isToggle,
	}, b)
	corner(dot, 4)

	local nameLbl = make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 34),
		Size = UDim2.new(1, -12, 0, 16),
		Text = name,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, b)
	make("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 7 }, nameLbl)

	local api = { On = false }

	function api.Set(on)
		api.On = on
		local ti = TweenInfo.new(0.2)
		TweenService:Create(b, ti, { BackgroundColor3 = on and THEME.CardOn or THEME.Card }):Play()
		TweenService:Create(st, ti, {
			Color = on and THEME.Accent or THEME.Off,
			Transparency = on and 0 or 0.5,
		}):Play()
		TweenService:Create(dot, ti, { BackgroundColor3 = on and THEME.Accent or THEME.PillOff }):Play()
	end

	b.MouseButton1Click:Connect(function() onClick(api) end)
	return api
end

local function onoff(v) return v and "ON" or "OFF" end

-- ESP: mỗi loại một nút riêng
local function espCard(order, icon, name, kind)
	card(order, icon, name, true, function(c)
		ESP[kind] = not ESP[kind]
		c.Set(ESP[kind])
		ESP.Refresh()
		setStatus(name .. " " .. onoff(ESP[kind]))

		if ESP[kind] then
			task.delay(1.2, function()
				if not ESP[kind] then return end
				local n = ESP.CountKind(kind)
				setStatus(n > 0
					and (name .. " ON • " .. n .. " mục tiêu")
					or (name .. ": chưa thấy mục tiêu nào"))
			end)
		end
	end)
end

