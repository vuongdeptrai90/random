----------------------------------------------------------------
-- VÒNG LẶP FAST RELOAD
----------------------------------------------------------------
task.spawn(function()
	while task.wait() do
		if _G.FastReload then
			local char = p.Character
			local tool = char and char:FindFirstChildOfClass("Tool")
			if tool then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local animator = hum and hum:FindFirstChildOfClass("Animator")
				if animator then
					for _, track in pairs(animator:GetPlayingAnimationTracks()) do
						if track.Name:lower():find("reload") then
							track:Stop(0)
						end
					end
				end

				for _, item in pairs(tool:GetDescendants()) do
					if item:IsA("NumberValue") or item:IsA("IntValue") then
						local name = item.Name:lower()
						if name:find("reload") or name:find("cooldown") or name:find("delay") then
							item.Value = 0
						end
					end
				end

				local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("Clip") or tool:FindFirstChild("CurrentAmmo")
				local maxAmmo = tool:FindFirstChild("MaxAmmo") or tool:FindFirstChild("MaxClip")
				if ammo and maxAmmo and ammo:IsA("ValueBase") and maxAmmo:IsA("ValueBase") then
					ammo.Value = maxAmmo.Value
				end
			end
		end
	end
end)

