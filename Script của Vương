-- MỞ / ĐÓNG / THU NHỎ
----------------------------------------------------------------
local hubOpen = false
local minimized = false

local function showHub(state)
	hubOpen = state
	if state then
		hub.Visible = true
		hubScale.Scale = 0.85
		TweenService:Create(hubScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	else
		local t = TweenService:Create(hubScale, TweenInfo.new(0.15), { Scale = 0.85 })
		t:Play()
		t.Completed:Once(function()
			if not hubOpen then hub.Visible = false end
		end)
	end
end

local function setMinimized(state)
	minimized = state
	body.Visible = not state
	TweenService:Create(hub, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(W, state and H_MIN or H_FULL),
	}):Play()
	minBtn.Text = state and "+" or "-"
end

open.MouseButton1Click:Connect(function() showHub(not hubOpen) end)
closeBtn.MouseButton1Click:Connect(function() showHub(false) end)
minBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end)
