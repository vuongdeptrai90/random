local canSave = type(writefile) == "function"
	and type(readfile) == "function"
	and type(isfile) == "function"

local function loadSettings()
	if not canSave then return end
	local ok, data = pcall(function()
		if isfile(SAVE_FILE) then
			return HttpService:JSONDecode(readfile(SAVE_FILE))
		end
	end)
	if ok and type(data) == "table" then
		for k, def in pairs(DEFAULTS) do
			if type(data[k]) == type(def) then CFG[k] = data[k] end
		end
	end
end

local function writeNow()
	if not canSave then return false end
	return (pcall(function()
		writefile(SAVE_FILE, HttpService:JSONEncode(CFG))
	end))
end

-- lưu có trễ 0.6 giây để không ghi file liên tục khi giữ nút +/-
local saveToken = 0
local function save()
	if not canSave then return end
	saveToken += 1
	local my = saveToken
	task.delay(0.6, function()
		if alive and my == saveToken then writeNow() end
	end)
end

