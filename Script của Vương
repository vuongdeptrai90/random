local frames, fps = 0, 0
local fpsConn

local function startFps()
	if fpsConn then return end
	frames, fps = 0, 0
	fpsConn = RunService.Heartbeat:Connect(function() frames += 1 end)
end

local function stopFps()
	if fpsConn then
		fpsConn:Disconnect()
		fpsConn = nil
	end
end

local function getPing()
	local ok, v = pcall(function()
		return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	end)
	return ok and (v .. " ms") or "-"
end

local function refreshInfo()
	rPlayers.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
	rPing.Text = getPing()
	rFps.Text = fps > 0 and tostring(fps) or "..."
end

