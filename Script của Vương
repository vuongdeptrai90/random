local rPlayers = row("Người chơi", "-")
local rPing = row("Ping", "-")
local rFps = row("FPS", "-")
local rUser = row("Tài khoản", p.DisplayName .. " (@" .. p.Name .. ")")

task.spawn(function()
	local ok, res = pcall(function()
		return MarketplaceService:GetProductInfo(game.PlaceId)
	end)
	rGame.Text = (ok and res and res.Name) or "Không lấy được tên"
end)

local frames, fps = 0, 0
local fpsConn

local function startFps()
	if fpsConn then return end
	frames, fps = 0, 0
	fpsConn = RunService.Heartbeat:Connect(function() frames += 1 end)
end

local function stopFps()
	if fpsConn then
		fpsConn:Disconnect()
		fpsConn = nil
	end
end

local function getPing()
	local ok, v = pcall(function()
		return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	end)
	return ok and (v .. " ms") or "-"
end

local function refreshInfo()
	rPlayers.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
	rPing.Text = getPing()
	rFps.Text = fps > 0 and tostring(fps) or "..."
end

task.spawn(function()
	while task.wait(1) do
		if infoPage.Visible and hub.Visible then
			startFps()
			fps = frames
			frames = 0
			refreshInfo()
		else
			stopFps()  -- không xem Info thì không đếm gì cả
		end
	end
end)

