local function card(order, icon, name, isToggle, onClick)
	local b = make("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = THEME.Card,
		LayoutOrder = order,
	}, grid)
	corner(b, 10)

	local st = make("UIStroke", {
		Color = THEME.Off,
		Thickness = 1.2,
		Transparency = 0.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, b)

	make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.fromOffset(30, 30),
		Text = icon,
		TextSize = 22,
	}, b)

	make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 40),
		Size = UDim2.new(1, -16, 0, 16),
		Text = name,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, b)

	local pill = make("Frame", {
		Position = UDim2.new(1, -44, 0, 10),
		Size = UDim2.fromOffset(34, 16),
		BackgroundColor3 = THEME.PillOff,
		Visible = isToggle,
	}, b)
	corner(pill, 8)

	local pillTxt = make("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "OFF",
		Font = Enum.Font.GothamBold,
		TextSize = 9,
		TextColor3 = THEME.Sub,
	}, pill)

	local api = { On = false }

	function api.Set(on)
		api.On = on
		local ti = TweenInfo.new(0.2)
		TweenService:Create(b, ti, { BackgroundColor3 = on and THEME.CardOn or THEME.Card }):Play()
		TweenService:Create(st, ti, {
			Color = on and THEME.Accent or THEME.Off,
			Transparency = on and 0 or 0.5,
		}):Play()
		TweenService:Create(pill, ti, { BackgroundColor3 = on and THEME.Accent or THEME.PillOff }):Play()
		pillTxt.Text = on and "ON" or "OFF"
		pillTxt.TextColor3 = on and Color3.fromRGB(5, 20, 12) or THEME.Sub
	end

	b.MouseButton1Click:Connect(function() onClick(api) end)
	return api
end

local function onoff(v) return v and "ON" or "OFF" end

-- 1. Performance
local disabledEmitters = {}
card(1, "⚡", "Performance", true, function(c)
	local on = not c.On
	if on then
		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("ParticleEmitter") and v.Enabled then
				v.Enabled = false
				table.insert(disabledEmitters, v)
			end
		end
	else
		for _, v in ipairs(disabledEmitters) do
			if v.Parent then v.Enabled = true end
		end
		table.clear(disabledEmitters)
	end
	c.Set(on)
	setStatus("Performance " .. onoff(on))
end)

